# Sunucu
PORT=4000
SERVER_URL=http://localhost:4000
STOREFRONT_URL=http://localhost:5500
ADMIN_URL=http://localhost:5501
SAYFA_URL=http://localhost:53576

# Yönetici paneli ilk giriş bilgileri (ilk çalıştırmada otomatik oluşturulur)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# JWT oturum anahtarı - production'da mutlaka rastgele/uzun bir değerle değiştirin
JWT_SECRET=lutfen-bunu-uzun-rastgele-bir-degerle-degistirin

# iyzico API bilgileri
# Test (sandbox) hesabı: https://sandbox-merchant.iyzipay.com/auth/register
# Ayarlar > Firma Ayarları menüsünden API Key / Secret Key alınır.
IYZICO_API_KEY=sandbox-your-api-key
IYZICO_SECRET_KEY=sandbox-your-secret-key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Canlıya (gerçek ödeme) geçerken:
# IYZICO_BASE_URL=https://api.iyzipay.com
